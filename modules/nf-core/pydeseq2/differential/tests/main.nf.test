nextflow_process {

    name "Test Process PYDESEQ2_DIFFERENTIAL"
    script "../main.nf"
    process "PYDESEQ2_DIFFERENTIAL"

    tag "modules"
    tag "modules_nfcore"
    tag "deseq2"
    tag "pydeseq2/differential"
    tag "pydeseq2"

    test("mouse - contrasts - matrix") {
        config './pydeseq2_differential_matrix.config'

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'

                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[0] = ch_contrasts
                input[1] = [
                    [id: 'test'],
                    file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true),
                    file(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ]
                input[2] = [[], []]
                input[3] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.results[0][1]).text.readLines()[0].startsWith('gene_id\tbaseMean') },
                { assert path(process.out.size_factors[0][1]).text.readLines()[0] == 'sample\tsizeFactor' },
                { assert path(process.out.normalised_counts[0][1]).text.readLines()[0].startsWith('gene_id\t') },
                { assert path(process.out.vst_counts[0][1]).exists() },
                { assert snapshot(
                        process.out.results,
                        process.out.size_factors,
                        process.out.normalised_counts,
                        process.out.vst_counts,
                        process.out.model,
                        process.out.versions,
                        file(process.out.dispersion_plot_png[0][1]).name,
                        file(process.out.dispersion_plot_pdf[0][1]).name,
                        file(process.out.h5ad[0][1]).name
                    ).match() },
                { assert file(process.out.dispersion_plot_png[0][1]).name.endsWith('.pydeseq2.dispersion.png') },
                { assert file(process.out.dispersion_plot_pdf[0][1]).name.endsWith('.pydeseq2.dispersion.pdf') },
                { assert file(process.out.h5ad[0][1]).name.endsWith('.pydeseq2.dds.h5ad') },
                { assert path(process.out.model[0][1]).text.startsWith('~') },
                { assert path(process.out.session_info[0][1]).text.contains('PyDESeq2 session information') },
                { assert path(process.out.session_info[0][1]).text.contains('r_style_parametric_dispersion_fit') },
                { assert path(process.out.session_info[0][1]).text.contains('parametric_dispersion_min_disp_multiplier') },
                { assert path(process.out.session_info[0][1]).text.contains('parametric_dispersion_genes_before_r_style_filter') },
                { assert path(process.out.session_info[0][1]).text.contains('parametric_dispersion_genes_after_r_style_filter') },
                { assert path(process.out.session_info[0][1]).text.contains('r_style_independent_filtering') },
                { assert path(process.out.session_info[0][1]).text.contains('transcript_length_normalization_enabled') },
                { assert path(process.out.versions[0]).yaml }
            )
        }
    }

    test("RNAseq - Feature Counts - formula coefficient") {
        config './pydeseq2_differential_formula.config'

        when {
            process {
                """
                input[0] = Channel.of([
                    'id': 'genotype_WT_vs_baseline',
                    'formula': '~ genotype',
                    'comparison': 'genotype[T.WT]'
                ]).map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[1] = Channel.of([
                    [ id: 'test' ],
                    file('https://github.com/nf-core/test-datasets/raw/differentialabundance/modules_testdata/variancepartition_dream/metadata.tsv', checkIfExists: true),
                    file('https://github.com/nf-core/test-datasets/raw/differentialabundance/modules_testdata/variancepartition_dream/counts.tsv', checkIfExists: true)
                ])

                input[2] = [[], []]
                input[3] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.results[0][1]).text.readLines()[0].contains('log2FoldChange') },
                { assert path(process.out.model[0][1]).text.trim() == '~ genotype' },
                { assert snapshot(
                        process.out.results,
                        process.out.size_factors,
                        process.out.normalised_counts,
                        process.out.vst_counts,
                        process.out.model,
                        process.out.versions,
                        file(process.out.dispersion_plot_png[0][1]).name,
                        file(process.out.dispersion_plot_pdf[0][1]).name,
                        file(process.out.h5ad[0][1]).name
                    ).match() },
                { assert path(process.out.versions[0]).yaml }
            )
        }
    }

    test("mouse - contrasts - matrix - control genes") {
        config './pydeseq2_differential_control_genes.config'

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'

                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[0] = ch_contrasts
                input[1] = [
                    [id: 'test'],
                    file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true),
                    file(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ]
                input[2] = [
                    [id: 'ERCC'],
                    file(expression_test_data_dir + 'SRP254919.spikes.tsv', checkIfExists: true)
                ]
                input[3] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.size_factors[0][1]).text.contains('sizeFactor') },
                { assert snapshot(
                        process.out.results,
                        process.out.size_factors,
                        process.out.normalised_counts,
                        process.out.vst_counts,
                        process.out.model,
                        process.out.versions,
                        file(process.out.dispersion_plot_png[0][1]).name,
                        file(process.out.dispersion_plot_pdf[0][1]).name,
                        file(process.out.h5ad[0][1]).name
                    ).match() },
                { assert path(process.out.versions[0]).yaml }
            )
        }
    }

    test("mouse - contrasts - matrix - subset to contrast") {
        config './pydeseq2_differential_subset_to_contrast.config'

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'

                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[0] = ch_contrasts
                input[1] = [
                    [id: 'test'],
                    file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true),
                    file(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ]
                input[2] = [[], []]
                input[3] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.normalised_counts[0][1]).exists() },
                { assert snapshot(
                        process.out.results,
                        process.out.size_factors,
                        process.out.normalised_counts,
                        process.out.vst_counts,
                        process.out.model,
                        process.out.versions,
                        file(process.out.dispersion_plot_png[0][1]).name,
                        file(process.out.dispersion_plot_pdf[0][1]).name,
                        file(process.out.h5ad[0][1]).name
                    ).match() },
                { assert path(process.out.versions[0]).yaml }
            )
        }
    }

    test("mouse - contrasts - matrix - exclude samples") {
        config './pydeseq2_differential_exclude_samples.config'

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'

                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[0] = ch_contrasts
                input[1] = [
                    [id: 'test'],
                    file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true),
                    file(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ]
                input[2] = [[], []]
                input[3] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.size_factors[0][1]).exists() },
                { assert snapshot(
                        process.out.results,
                        process.out.size_factors,
                        process.out.normalised_counts,
                        process.out.vst_counts,
                        process.out.model,
                        process.out.versions,
                        file(process.out.dispersion_plot_png[0][1]).name,
                        file(process.out.dispersion_plot_pdf[0][1]).name,
                        file(process.out.h5ad[0][1]).name
                    ).match() },
                { assert path(process.out.versions[0]).yaml }
            )
        }
    }

    test("mouse - contrasts - matrix - csv counts") {
        config './pydeseq2_differential_matrix.config'

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'

                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                ch_matrix = Channel.fromPath(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv')
                    .splitCsv(header: false, sep: '\t')
                    .map { it.join(',') }
                    .collectFile(name: 'counts.csv', newLine: true, sort: false)
                    .map { [[id: 'test'], file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true), it] }

                input[0] = ch_contrasts
                input[1] = ch_matrix
                input[2] = [[], []]
                input[3] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.results[0][1]).exists() },
                { assert snapshot(
                        process.out.results,
                        process.out.size_factors,
                        process.out.normalised_counts,
                        process.out.vst_counts,
                        process.out.model,
                        process.out.versions,
                        file(process.out.dispersion_plot_png[0][1]).name,
                        file(process.out.dispersion_plot_pdf[0][1]).name,
                        file(process.out.h5ad[0][1]).name
                    ).match() },
                { assert path(process.out.versions[0]).yaml }
            )
        }
    }

    test("mouse - contrasts - matrix - stub") {
        config './pydeseq2_differential_matrix.config'
        options "-stub"

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'

                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[0] = ch_contrasts
                input[1] = [
                    [id: 'test'],
                    file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true),
                    file(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ]
                input[2] = [[], []]
                input[3] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.h5ad[0][1]).name.endsWith('.pydeseq2.dds.h5ad') },
                { assert snapshot(
                        process.out.results,
                        process.out.size_factors,
                        process.out.normalised_counts,
                        process.out.vst_counts,
                        process.out.model,
                        process.out.versions,
                        file(process.out.dispersion_plot_png[0][1]).name,
                        file(process.out.dispersion_plot_pdf[0][1]).name,
                        file(process.out.h5ad[0][1]).name
                    ).match() },
                { assert path(process.out.versions[0]).yaml }
            )
        }
    }

    test("unsupported rlog fails clearly") {
        config './pydeseq2_differential_rlog_unsupported.config'

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'
                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                input[0] = ch_contrasts
                input[1] = [[id: 'test'], file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true), file(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)]
                input[2] = [[], []]
                input[3] = [[], []]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('rlog is an R DESeq2 transform')
        }
    }

    test("mouse - contrasts - matrix - transcript lengths") {
        config './pydeseq2_differential_matrix.config'

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'
                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                input[0] = ch_contrasts
                input[1] = [[id: 'test'], file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true), file(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)]
                input[2] = [[], []]
                input[3] = [[id: 'test'], file(expression_test_data_dir + 'SRP254919.spoofed_lengths.tsv', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.normalization_factors[0][1]).exists() },
                { assert path(process.out.session_info[0][1]).text.contains('transcript_length_normalization_enabled') },
                { assert path(process.out.session_info[0][1]).text.contains('normalization_factor_shape') },
                { assert path(process.out.session_info[0][1]).text.contains('sample_size_factor_summary') }
            )
        }
    }

    test("unsupported shrink_lfc fails clearly") {
        config './pydeseq2_differential_shrink_unsupported.config'

        when {
            process {
                """
                expression_test_data_dir = params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/'
                ch_contrasts = Channel.fromPath(file(expression_test_data_dir + 'SRP254919.contrasts.csv', checkIfExists: true))
                    .splitCsv(header: true, sep: ',')
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                input[0] = ch_contrasts
                input[1] = [[id: 'test'], file(expression_test_data_dir + 'SRP254919.samplesheet.csv', checkIfExists: true), file(expression_test_data_dir + 'SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)]
                input[2] = [[], []]
                input[3] = [[], []]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('ASHR-compatible shrink_lfc')
        }
    }
}
